{
  "multipart": [
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "bf:block/power_line_pole"
      }
    },
    {
      "when": {
        "up": "false",
        "north": "true",
        "south": "true"
      },
      "apply": {
        "model": "bf:block/power_line_wire"
      }
    },
    {
      "when": {
        "up": "false",
        "east": "true",
        "west": "true"
      },
      "apply": {
        "model": "bf:block/power_line_wire",
        "y": 90
      }
    },
    {
      "when": {
        "OR": [
          {
            "up": "true",
            "north": "true"
          },
          {
            "up": "true",
            "south": "true"
          }
        ]
      },
      "apply": {
        "model": "bf:block/power_line"
      }
    },
    {
      "when": {
        "OR": [
          {
            "up": "true",
            "east": "true"
          },
          {
            "up": "true",
            "west": "true"
          }
        ]
      },
      "apply": {
        "model": "bf:block/power_line",
        "y": 90
      }
    }
  ]
}
